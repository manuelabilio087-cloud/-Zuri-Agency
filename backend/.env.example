# Servidor
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Base de dados (Supabase — usa o pooler, não a ligação direta)
# DATABASE_URL: pooler em modo "transaction" (porta 6543) — usado pela app em runtime
DATABASE_URL="postgresql://postgres.xxxxxxx:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: pooler em modo "session" (porta 5432) — usado só para migrações (prisma db push)
DIRECT_URL="postgresql://postgres.xxxxxxx:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Autenticação
JWT_SECRET="troca-isto-por-um-segredo-forte-em-producao"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="troca-isto-tambem-por-outro-segredo-forte"
JWT_REFRESH_EXPIRES_IN="30d"

# Google Places API (fase 2 - módulo companies)
GOOGLE_PLACES_API_KEY=""

# Anthropic API (fase 2 - módulo AI: scoring e geração de conteúdo)
ANTHROPIC_API_KEY=""

# Pagamentos (fase 2 - módulo billing)
PAYSUITE_API_KEY=""
QUICK_E_PAY_API_KEY=""
